<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Elsevier numeric (Virtual BAS manuscript)</title>
    <id>virtual-bas-elsevier-numeric</id>
    <updated>2026-11-08T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="never" name-as-sort-order="all" sort-separator=", "/>
      <substitute><names variable="editor"/><text variable="publisher"/></substitute>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <macro name="container">
    <choose>
      <if type="article-journal">
        <group delimiter=" ">
          <text variable="container-title" form="short"/>
          <text variable="volume"/>
          <text macro="year" prefix="(" suffix=")"/>
        </group>
        <choose>
          <if variable="page"><text variable="page" prefix=" "/></if>
        </choose>
      </if>
      <else-if type="paper-conference chapter" match="any">
        <group delimiter=", ">
          <text variable="container-title" prefix="in: "/>
          <text variable="publisher-place"/>
          <text macro="year"/>
          <text variable="page" prefix="pp. "/>
        </group>
      </else-if>
      <else-if type="report">
        <group delimiter=", ">
          <text variable="number"/>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text macro="year"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text macro="year"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=", ">
        <text macro="author"/>
        <text variable="title"/>
        <text macro="container"/>
      </group>
      <text variable="DOI" prefix=". https://doi.org/"/>
      <choose>
        <if variable="DOI" match="none"><text variable="URL" prefix=". "/></if>
      </choose>
    </layout>
  </bibliography>
</style>
